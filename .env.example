# SAGA 3D consolidated workspace - copy to .env (never commit .env).
# All values are optional; defaults live in config/*.yaml.
# NOTE: since the Phase 1-3 host tree is consolidated INSIDE this repository (host/),
# there is NO SAGA3_ROOT variable anymore and none is needed.

# Combined host + world adapter bind address/port (config/world.yaml endpoint section holds the same values).
# GODOT connects to ws://<SAGA_HOST>:<SAGA_PORT>/ws/world?session=<session_id>
SAGA_HOST=127.0.0.1
SAGA_PORT=8765

# Runtime outputs (defaults applied by adapter/saga4_world/attach.py point INTO this repository).
# SAGA_LOG_DIR=D:\collega active\phases\saga-3d-phase-4\logs
# SAGA_CALIBRATION_DIR=D:\collega active\phases\saga-3d-phase-4\calibration

# Comma-separated Origins allowed to open the sensor WebSocket / call state-changing HTTP APIs.
# Empty (default) = no Origin restriction; trusted-LAN development only.
# SAGA_ALLOWED_ORIGINS=

# Optional TLS for phones (browser camera access needs a secure context).
# Generate a local dev certificate with:  bash scripts/make_dev_cert.sh <your-LAN-IP>
# SAGA_TLS_CERT=certs/dev.crt
# SAGA_TLS_KEY=certs/dev.key
