# SAGA 3D Phase 4 - copy to ../.env (or export) before launching scripts/run_host.py.
# Every default keeps RUNTIME WRITES out of the Phases 1-3 repository (which stays READ-ONLY).

# Path of the READ-ONLY Phases 1-3 repository (imported, never copied or edited).
SAGA3_ROOT=D:\collega active\phases\saga-3d phase 3

# Combined host + world adapter bind address/port (config/world.yaml endpoint section holds the same values).
# GODOT connects to ws://<SAGA_HOST>:<SAGA_PORT>/ws/world?session=<session_id>
SAGA_HOST=127.0.0.1
SAGA_PORT=8765

# Runtime outputs. Defaults (applied by adapter/saga4_world/attach.py) point INTO the Phase 4 tree:
#   SAGA_LOG_DIR          = <phase4>/logs
#   SAGA_CALIBRATION_DIR  = <phase4>/calibration
# Set them explicitly to override; never point them into the Phases 1-3 repo.
# SAGA_LOG_DIR=D:\collega active\phases\saga-3d-phase-4\logs
# SAGA_CALIBRATION_DIR=D:\collega active\phases\saga-3d-phase-4\calibration

# Optional overrides supported by the Phase 1-3 host configuration loader, e.g.:
# SAGA_ALLOWED_ORIGINS=            # empty (default) = no Origin restriction; trusted LAN only
